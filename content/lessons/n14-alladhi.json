 "understand": [
  {
   "examples": [
    {
     "ar": "هَذَا رَجُلٌ.",
     "en": "This is a man."
    },
    {
     "ar": "هَذَا الرَّجُلُ طَبِيبٌ.",
     "en": "This man is a doctor."
    },
    {
     "ar": "ذَلِكَ الْبَيْتُ كَبِيرٌ.",
     "en": "That house is big."
    },
    {
     "ar": "هَذِهِ السَّيَّارَةُ جَدِيدَةٌ.",
     "en": "This car is new."
    }
   ]
  },
  {
   "rule": "<span class='ar'>هَذَا</span> + a noun with <span class='ar'>الْ</span> is a phrase, not a sentence: <span class='ar'>هَذَا الرَّجُلُ</span> = this man. Finish it with a khabar: <span class='ar'>هَذَا الرَّجُلُ طَبِيبٌ</span>. Without <span class='ar'>الْ</span>, <span class='ar'>هَذَا رَجُلٌ</span> is already a sentence: <em>This is a man.</em>"
  },
  {
   "h": "Whose? with لِـ"
  },
  {
   "examples": [
    {
     "ar": "لِمَنْ هَذَا الْقَلَمُ؟",
     "en": "Whose pen is this?"
    },
    {
     "ar": "هُوَ لِحَامِدٍ.",
     "en": "It's Hamid's."
    },
    {
     "ar": "هَذِهِ السَّيَّارَةُ لِلْمُدَرِّسِ.",
     "en": "This car belongs to the teacher."
    },
    {
     "ar": "هَذَا الْبَيْتُ لِأَبِي.",
     "en": "This house is my father's."
    }
   ]
  },
  {
   "rule": "<span class='ar'>لِـ</span> (for, belonging to) is a preposition, so the noun after it is majrūr. With <span class='ar'>الْ</span> the alif drops: <span class='ar'>لِ</span> + <span class='ar'>الْمُدَرِّسِ</span> → <span class='ar'>لِلْمُدَرِّسِ</span>."
  },
  {
   "h": "In front, behind, under"
  },
  {
   "examples": [
    {
     "ar": "الْمُدَرِّسُ أَمَامَ السَّبُّورَةِ.",
     "en": "The teacher is in front of the blackboard."
    },
    {
     "ar": "الْحَقِيبَةُ تَحْتَ الْمَكْتَبِ.",
     "en": "The bag is under the desk."
    },
    {
     "ar": "جَلَسَ حَامِدٌ خَلْفَ مُحَمَّدٍ.",
     "en": "Hamid sat behind Muhammad."
    }
   ]
  },
  {
   "rule": "<span class='ar'>أَمَامَ</span>، <span class='ar'>خَلْفَ</span>، <span class='ar'>تَحْتَ</span> work like <span class='ar'>فِي</span> and <span class='ar'>عَلَى</span>: the noun after them is majrūr."
  },
  {
   "h": "The one who"
  },
  {
   "examples": [
    {
     "ar": "الرَّجُلُ الَّذِي خَرَجَ الْآنَ مُدَرِّسٌ.",
     "en": "The man who just went out is a teacher."
    },
    {
     "ar": "مَنِ الْوَلَدُ الَّذِي فِي الْفَصْلِ؟",
     "en": "Who is the boy who is in the classroom?"
    },
    {
     "ar": "السَّيَّارَةُ الَّتِي أَمَامَ الْبَيْتِ لِأَبِي.",
     "en": "The car (that is) in front of the house is my father's."
    }
   ]
  },
  {
   "rule": "<span class='ar'>الَّذِي</span> (masculine) and <span class='ar'>الَّتِي</span> (feminine) attach a description to a noun with <span class='ar'>الْ</span>, like English <em>who / which / that</em>. They never change their ending."
  },
  {
   "tip": "<span class='ar'>مَنْ</span> becomes <span class='ar'>مَنِ</span> before <span class='ar'>الْ</span> so the words join smoothly: <span class='ar'>مَنِ الْوَلَدُ؟</span>. <span class='ar'>مُسْتَشْفًى</span> never shows its case: <span class='ar'>فِي الْمُسْتَشْفَى</span>، <span class='ar'>مِنَ الْمُسْتَشْفَى</span>."
  }
 ],
