{
 "id": "r4-sukun-shadda",
 "title": "Sukūn and shadda",
 "ar": "السُّكُونُ وَالشَّدَّة",
 "goal": "Read letters with no vowel (sukūn) and doubled letters (shadda).",
 "noAutoVocab": true,
 "words": [],
 "understand": [
  {
   "h": "Sukūn: no vowel"
  },
  {
   "p": "A small circle <span class='ar'>ْ</span> above a letter means it has <strong>no vowel</strong>. It closes the syllable before it."
  },
  {
   "examples": [
    {
     "ar": "مِنْ",
     "en": "min"
    },
    {
     "ar": "قُلْ",
     "en": "qul"
    },
    {
     "ar": "بَيْتُ",
     "en": "bay-tu"
    },
    {
     "ar": "كَلْبُ",
     "en": "kal-bu"
    },
    {
     "ar": "مَسْجِدُ",
     "en": "mas-ji-du"
    }
   ]
  },
  {
   "h": "Shadda: doubled letter"
  },
  {
   "p": "A small w-shape <span class='ar'>ّ</span> above a letter means it is said <strong>twice</strong>: once closing the syllable before it, once opening the next. Hold it a moment longer. Shadda always comes with a vowel too."
  },
  {
   "examples": [
    {
     "ar": "رَبَّ",
     "en": "rab-ba"
    },
    {
     "ar": "مُدَرِّسُ",
     "en": "mu-dar-ri-su"
    },
    {
     "ar": "عَلَّمَ",
     "en": "ʿal-la-ma"
    },
    {
     "ar": "قِطُّ",
     "en": "qiṭ-ṭu"
    }
   ]
  },
  {
   "rule": "Sukūn = stop the letter. Shadda = say the letter twice. Missing a shadda can change the meaning: <span class='ar'>عَلِمَ</span> ʿalima (he knew) vs <span class='ar'>عَلَّمَ</span> ʿallama (he taught)."
  }
 ],
