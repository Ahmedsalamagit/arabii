{
  "id": "f2-short-vowels",
  "title": "Short Vowels (Harakat)",
  "summary": "Fatha, kasra, damma, sukun, shadda, and tanween.",
  "quizMode": "ar-en",
  "hideVocab": true,
  "sections": [
    { "type": "text", "body": "<p>Short vowels are written as small marks above or below a letter. Everyday books and newspapers usually leave them out, but the Quran, children's books, and learner material always include them. Learning them is how you'll read correctly from day one.</p>" },
    { "type": "heading", "text": "The three short vowels" },
    { "type": "table", "headers": ["Example", "Mark", "Sound"], "arCols": [0], "rows": [
      ["بَ", "fatḥa: a small slash above", "ba (short a)"],
      ["بِ", "kasra: a small slash below", "bi (short i)"],
      ["بُ", "ḍamma: a small wāw above", "bu (short u)"]
    ] },
    { "type": "heading", "text": "Other marks" },
    { "type": "table", "headers": ["Example", "Mark", "What it does"], "arCols": [0], "rows": [
      ["بْ", "sukūn: a small circle above", "no vowel; the letter stops (as in ab)"],
      ["بّ", "shadda: a small w shape above", "doubles the letter (bb); usually paired with a vowel"],
      ["بً", "tanwīn fatḥa: two slashes above", "-an at the end of a word"],
      ["بٍ", "tanwīn kasra: two slashes below", "-in at the end of a word"],
      ["بٌ", "tanwīn ḍamma: two ḍammas above", "-un at the end of a word"]
    ] },
    { "type": "note", "body": "Practice: read these aloud, right to left. <span class='ar' lang='ar' style='font-size:1.6rem'>كَتَبَ</span> kataba (he wrote), <span class='ar' lang='ar' style='font-size:1.6rem'>دَرَسَ</span> darasa (he studied), <span class='ar' lang='ar' style='font-size:1.6rem'>قُلْ</span> qul (say!)." }
  ],
  "vocab": [
    { "ar": "بَ", "tr": "ba", "en": "fatḥa (a)" },
    { "ar": "بِ", "tr": "bi", "en": "kasra (i)" },
    { "ar": "بُ", "tr": "bu", "en": "ḍamma (u)" },
    { "ar": "بْ", "tr": "b", "en": "sukūn (no vowel)" },
    { "ar": "بّ", "tr": "bb", "en": "shadda (doubled)" },
    { "ar": "بً", "tr": "ban", "en": "tanwīn -an" },
    { "ar": "بٍ", "tr": "bin", "en": "tanwīn -in" },
    { "ar": "بٌ", "tr": "bun", "en": "tanwīn -un" },
    { "ar": "كَتَبَ", "tr": "kataba", "en": "he wrote" },
    { "ar": "دَرَسَ", "tr": "darasa", "en": "he studied" },
    { "ar": "قُلْ", "tr": "qul", "en": "say!" }
  ]
}
