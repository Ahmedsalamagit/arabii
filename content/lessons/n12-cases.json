     ],
     [
      "naṣb (manṣūb)",
      "fatḥa -a / -an",
      "mafʿūl bihi (this lesson), يَا + iḍāfa (L10)"
     ],
     [
      "jarr (majrūr)",
      "kasra -i / -in",
      "after a preposition (L5), 2nd noun of iḍāfa (L6)"
     ]
    ]
   }
