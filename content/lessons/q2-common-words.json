{
  "id": "q2-common-words",
  "title": "High-Frequency Quranic Words",
  "summary": "Small words that unlock a large share of the Quran.",
  "quranic": true,
  "sections": [
    { "type": "text", "body": "<p>A small set of words, mostly prepositions, particles, and a few common nouns and verbs, makes up a large share of the Quran's text. Learn these and you'll start recognizing pieces of almost every āyah you hear.</p>" },
    { "type": "note", "body": "Tip: when you hear recitation in prayer this week, listen for <span class='quran' lang='ar' style='font-size:1.4rem'>مِنْ</span>, <span class='quran' lang='ar' style='font-size:1.4rem'>فِي</span> and <span class='quran' lang='ar' style='font-size:1.4rem'>قَالَ</span>. Catching them in real recitation is what makes them stick." }
  ],
  "vocab": [
    { "ar": "مِنْ", "tr": "min", "en": "from; of" },
    { "ar": "فِي", "tr": "fī", "en": "in" },
    { "ar": "عَلَى", "tr": "ʿalā", "en": "on; upon" },
    { "ar": "إِلَى", "tr": "ilā", "en": "to; towards" },
    { "ar": "لَا", "tr": "lā", "en": "no; not" },
    { "ar": "مَا", "tr": "mā", "en": "what; not" },
    { "ar": "إِنَّ", "tr": "inna", "en": "indeed; truly" },
    { "ar": "الَّذِي", "tr": "alladhī", "en": "the one who; which" },
    { "ar": "قَالَ", "tr": "qāla", "en": "he said" },
    { "ar": "كَانَ", "tr": "kāna", "en": "he / it was" },
    { "ar": "رَبّ", "tr": "rabb", "en": "Lord" },
    { "ar": "يَوْم", "tr": "yawm", "en": "day" },
    { "ar": "شَيْء", "tr": "shayʾ", "en": "thing" },
    { "ar": "قَوْم", "tr": "qawm", "en": "people; nation" },
    { "ar": "أَرْض", "tr": "arḍ", "en": "earth; land" },
    { "ar": "سَمَاء", "tr": "samāʾ", "en": "sky; heaven" },
    { "ar": "نَاس", "tr": "nās", "en": "mankind; people" },
    { "ar": "عِلْم", "tr": "ʿilm", "en": "knowledge" }
  ]
