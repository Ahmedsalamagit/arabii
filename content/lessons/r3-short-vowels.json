{
 "id": "r3-short-vowels",
 "title": "Short vowels",
 "ar": "الحَرَكَات",
 "goal": "Read any letter with fatḥa, kasra or ḍamma, and read short words built from them.",
 "noAutoVocab": true,
 "words": [],
 "understand": [
  {
   "p": "Arabic writes its three short vowels as small marks called <strong>ḥarakāt</strong>. Everyday print leaves them out, but the Quran, children's books and this course always show them, so you can read every word correctly."
  },
  {
   "table": {
    "headers": [
     "Mark",
     "Name",
     "Sound",
     "Example"
    ],
    "ar": [
     3
    ],
    "rows": [
     [
      "slash above",
      "fatḥa",
      "a",
      "بَ  تَ  كَ"
     ],
     [
      "slash below",
      "kasra",
      "i",
      "بِ  تِ  كِ"
     ],
     [
      "small wāw above",
      "ḍamma",
      "u",
      "بُ  تُ  كُ"
     ]
    ]
   }
  },
  {
   "examples": [
    {
     "ar": "بَ بِ بُ",
     "en": "ba · bi · bu"
    },
    {
     "ar": "دَ دِ دُ",
     "en": "da · di · du"
    },
    {
     "ar": "قَ قِ قُ",
     "en": "qa · qi · qu"
    }
   ]
  },
  {
   "rule": "Every letter with a vowel mark makes its <strong>consonant first, then the vowel</strong>: <span class='ar'>كَ</span> = ka. Read a word right to left, one letter+vowel at a time."
  },
  {
   "examples": [
    {
     "ar": "كَتَبَ",
     "en": "ka-ta-ba"
    },
    {
     "ar": "دَرَسَ",
     "en": "da-ra-sa"
    },
    {
     "ar": "ذَهَبَ",
     "en": "dha-ha-ba"
    },
    {
     "ar": "كُتِبَ",
     "en": "ku-ti-ba"
    },
    {
     "ar": "فَهِمَ",
     "en": "fa-hi-ma"
    }
   ]
  },
  {
   "tip": "Next to heavy letters (<span class='ar'>ص ض ط ظ ق خ غ</span>), fatḥa sounds deeper, closer to the u in “sun”. Compare <span class='ar'>سَ</span> sa with <span class='ar'>صَ</span> ṣa."
  }
 ],
